# Скопируйте в .env и заполните значения. Файл .env в git не коммитится.

# Токен от @BotFather
BOT_TOKEN=

# Telegram user id (через запятую, без пробелов). Узнать: @userinfobot
ALLOWED_USER_IDS=

# RPC transmission-daemon (только localhost)
TRANSMISSION_HOST=127.0.0.1
TRANSMISSION_PORT=9091
TRANSMISSION_USER=
TRANSMISSION_PASSWORD=

# Пользователь ОС, от которого transmission-daemon пишет файлы (Ubuntu: debian-transmission)
TRANSMISSION_SYSTEM_USER=debian-transmission

# Прокси только для HTTP(S) трекеров (announce/scrape), не для пиров
# TRANSMISSION_PROXY_URL=socks5h://user:pass@host:1080

# Каталог загрузки по умолчанию (должен существовать; права — см. deploy/transmission-notes.md)
DEFAULT_DOWNLOAD_DIR=/var/lib/transmission-daemon/downloads

# Корни для кнопки «Обзор» в /folder (через запятую)
ALLOWED_ROOTS=/var/lib/transmission-daemon

DB_PATH=remotor.db
METADATA_TIMEOUT_SEC=300
STATUS_INTERVAL_SEC=15
